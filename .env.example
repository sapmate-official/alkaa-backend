# ==========================================
# Alkaa Backend - Environment Configuration
# ==========================================

# Server Settings
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL Prisma connection string)
DATABASE_URL="postgresql://username:password@localhost:5432/alkaa_db?schema=public"

# Frontend Application URLs (Used for CORS and links in emails)
CLIENT_URL=http://localhost:5174
ADMIN_URL=http://localhost:5174

# Authentication & JWT Secrets (Use strong random strings in production)
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_minimum_32_chars
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_minimum_32_chars
SUPER_ADMIN_SECRET_KEY=your_super_admin_creation_secret_key

# Email Service (Brevo / Sendinblue API)
BREVO_API_KEY=your_brevo_api_key
SENDER_EMAIL=noreply@alkaa.online
HR_EMAIL=hr@alkaa.online

# Web Push Notifications (VAPID Keys - generate via `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# WhatsApp Notifications (Optional)
WHATSAPP_API_URL=https://api.whatsapp.com/v1
WHATSAPP_API_KEY=your_whatsapp_api_key

# PDF & Email Branding Assets
COMPANY_LOGO_URL=https://www.alkaa.online/logo.svg

